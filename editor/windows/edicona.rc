// 010:4:1 L'icona (risorsa 1, quella che `edwv2.cc` mette alla finestra) e le informazioni di versione di bcdd-editor.exe.
1 ICON "edicona.ico"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x4L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "BCDD editor"
      VALUE "FileDescription", "bcdd-editor: window for editing BCDD files"
      VALUE "LegalCopyright", "Copyright 2026 Noli Paolo (BSD-3-Clause)"
      VALUE "OriginalFilename", "bcdd-editor.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
