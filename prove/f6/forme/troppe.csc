ENTITY Troppe VERSION 0.1
  PURPOSE "prova"
  VARIANT d1 = si
    GUARANTEE g1si: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d1 = no
    GUARANTEE g1no: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d2 = si
    GUARANTEE g2si: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d2 = no
    GUARANTEE g2no: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d3 = si
    GUARANTEE g3si: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d3 = no
    GUARANTEE g3no: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d4 = si
    GUARANTEE g4si: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d4 = no
    GUARANTEE g4no: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d5 = si
    GUARANTEE g5si: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d5 = no
    GUARANTEE g5no: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d6 = si
    GUARANTEE g6si: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d6 = no
    GUARANTEE g6no: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d7 = si
    GUARANTEE g7si: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT d7 = no
    GUARANTEE g7no: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
END
