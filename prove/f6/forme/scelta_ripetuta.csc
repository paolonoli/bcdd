ENTITY Ripetuta VERSION 0.1
  PURPOSE "prova"
  VARIANT modo = uno
    GUARANTEE r1: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT modo = due
    GUARANTEE r2: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
  VARIANT modo = uno
    GUARANTEE r3: VERBAL "una promessa"
      VERIFY BY JUDGEMENT "l'operatore"
END
