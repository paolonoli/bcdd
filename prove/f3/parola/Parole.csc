ENTITY Parole VERSION 0.1
  PURPOSE "Righe scritte male dentro l'elenco delle parti"
  OFFERS Luce
  COMPOSED OF
    q-1 : Pulsante
    VERSION : Pulsante
    true : Pulsante
    pulsante* : Pulsante
    1p : Pulsante
    -- un commento non chiude l'elenco

    p:Pulsante VERSION v1
    lampada : Lampada
    "pulsante" : Pulsante
    extra : Pulsante
END
