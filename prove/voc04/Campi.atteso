1. ERRORI: 0

2. GRADO DELLE RIGHE CONTRATTUALI
  verbale: 0
  formale: 0
  estensione dichiarata: 0
  non riconosciuta: 1
  riga 10: GUARANTEE ? non riconosciuta

3. UNDECIDED: 0

4. IPOTESI, NON CONTRATTO: 0

5. RIGHE NON RICONOSCIUTE: 8
  riga 5: EVENT IN KIND
  riga 6: STATE LEVEL : Boolean INITIAL false
