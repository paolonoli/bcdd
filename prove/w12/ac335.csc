CSC T VERSION 0.1
  PURPOSE "p"
  STATE p : Boolean INITIAL false
  STATE q : Boolean INITIAL false
  STATE c : Boolean INITIAL false
  CAPABILITY X
  EVENT IN pe
  GUARANTEE g1: ALWAYS EVENTUALLY p
  GUARANTEE g2: WHILE c: AFTER pe: ALWAYS q
  GUARANTEE g3: WHENEVER p THEN q WITHIN 1 s AT ONCE
  GUARANTEE g4: X REQUIRES c
END
