PROFILE Segnale VERSION 0.2
  PURPOSE "Grandezze"
  STATUS HYPOTHESIS
  EXTENSION FADE
    KIND     PATTERN
    LEVEL    CSC
    PARAMS   (s: Expression, d: Duration)
    FORM     "FADE s WITHIN d"
    MEANING  "s scende senza risalire"
    VERIFY   V1 C1 ; V2 "registrazione di s nel tempo"
    SOURCE   "la luce delle scale, promessa g10"
  END
END
