CSC T VERSION 0.1
  PURPOSE "p"
  STATE accesa : Boolean INITIAL false
  SCENARIO s1 EXPECT ADMITTED
  SCENARIO s1a DETAILS s1 STATUS HYPOTHESIS GIVEN accesa = false EXPECT ADMITTED
  GUARANTEE g1: VERBAL "x" VERIFY BY JUDGEMENT "y"
  SCENARIO s1b DETAILS g1 STATUS HYPOTHESIS GIVEN accesa = false EXPECT ADMITTED
END
