PROFILE T VERSION 0.1
  PURPOSE "p"
  EXTENSION DUR2
    KIND SCOPE
    LEVEL CSC
    PARAMS (c: Condition)
    FORM "DUR2 c"
    MEANING "m"
    VERIFY V1 C1
    SOURCE "s"
    REDUCES TO WHILE c AND c
  END
  EXTENSION NR
    KIND FUNCTION
    LEVEL CSC
    PARAMS (x: Real) : Boolean
    FORM "NR x"
    MEANING "m"
    VERIFY V1 C2
    SOURCE "s"
  END
END
CSC C VERSION 0.1
  IMPORT PROFILE T VERSION 0.1
  PURPOSE "x"
  STATE r : Real INITIAL 0.0
  STATE s : Boolean INITIAL false
  GUARANTEE g1: DUR2 s: ALWAYS s
  GUARANTEE g2: DUR2 (NR r): ALWAYS s
  GUARANTEE g3: DUR2 s: ALWAYS NR r
  GUARANTEE g4: ALWAYS (IF NR r THEN 1 ELSE 2) > 0
  GUARANTEE g5: WHILE s: ALWAYS s
END
