PROFILE Q VERSION 0.1
  PURPOSE "p"
  STATUS HYPOTHESIS
  EXTENSION A
    KIND PATTERN
    LEVEL CSC
    PARAMS (p: Condition, q: Condition)
    FORM "A p THEN q"
    MEANING "m"
    VERIFY V1 C1
    SOURCE "s"
    REDUCES TO WHENEVER p THEN q AT ONCE
  END
END

CSC P VERSION 0.1
  IMPORT PROFILE Q VERSION 0.1
  PURPOSE "sonda"
  STATUS HYPOTHESIS
  STATE s : Boolean INITIAL false
  DEFINE D := 5 s
  GUARANTEE g: A s THEN s
END
