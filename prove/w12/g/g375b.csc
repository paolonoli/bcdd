PROFILE Q VERSION 0.1
  PURPOSE "p"
  STATUS HYPOTHESIS
  EXTENSION A
    KIND PATTERN
    LEVEL CSC
    PARAMS (c: Condition, d: Duration)
    FORM "A c IN d"
    MEANING "m"
    VERIFY V1 C1
    SOURCE "s"
    REDUCES TO ALWAYS ALWAYS c
  END
END

CSC P VERSION 0.1
  IMPORT PROFILE Q VERSION 0.1
  PURPOSE "sonda"
  STATUS HYPOTHESIS
  STATE s : Boolean INITIAL false
  DEFINE D := 5 s
  GUARANTEE g: A s IN D
END
